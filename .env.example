
# --- SUPABASE (Postgres) — added for this project ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://bmtbidizyinepckjymea.supabase.co
SUPABASE_ANON_KEY=sbp_fc1348fd661941889dd27fdf927e3c8906129eed
# SERVICE ROLE = SERVER ONLY. NEVER put in frontend / index.html / src/supabaseClient.js / git.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Browser origin allowed to call the FastAPI API
FRONTEND_URL=http://localhost:8001
# GitHub App (server only). Grant Actions: read/write; Metadata: read.
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY=YOUR_GITHUB_APP_PRIVATE_KEY
GITHUB_INSTALLATION_ID=YOUR_GITHUB_INSTALLATION_ID
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET
# Resend notification delivery (server only). Verify the sender domain in Resend.
RESEND_API_KEY=YOUR_RESEND_API_KEY
NOTIFICATION_FROM_EMAIL="DevOps Intelligence <notifications@example.com>"
# Non-GitHub CI provider credentials (backend only; configure only providers in use).
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=YOUR_JENKINS_USER
JENKINS_API_TOKEN=YOUR_JENKINS_API_TOKEN
CIRCLECI_TOKEN=YOUR_CIRCLECI_TOKEN
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=YOUR_GITLAB_TOKEN
AZURE_DEVOPS_ORG=YOUR_AZURE_ORGANIZATION
AZURE_DEVOPS_PROJECT=YOUR_AZURE_PROJECT
AZURE_DEVOPS_PAT=YOUR_AZURE_DEVOPS_PAT
BITBUCKET_USERNAME=YOUR_BITBUCKET_USERNAME
BITBUCKET_API_TOKEN=YOUR_BITBUCKET_API_TOKEN
# Frontend (Vite) — these are safe to expose, they are the ANON key only
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Supabase CLI / GitHub
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=CHANGE_ME
# Storage bucket for pipeline logs (GitHub logs expire 90 days → copy here)
SUPABASE_STORAGE_BUCKET=pipeline-logs
